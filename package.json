{
    "name":  "dsh-plugin-voice-dialog",
    "version":  "1.44.0",
    "description":  "Р›РѕРєР°Р»СЊРЅС‹Р№ РіРѕР»РѕСЃРѕРІРѕР№ Р°СЃСЃРёСЃС‚РµРЅС‚ РґР»СЏ DSH: Р°РєС‚РёРІР°С†РёСЏ РїРѕ РёРјРµРЅРё СЃРІРѕРµР№ KWS-РјРѕРґРµР»СЊСЋ, СЂР°СЃРїРѕР·РЅР°РІР°РЅРёРµ GigaAM, РѕРґРёРЅ РіРѕР»РѕСЃ РґР»СЏ СЂСѓСЃСЃРєРѕРіРѕ Рё Р°РЅРіР»РёР№СЃРєРѕРіРѕ, РЅРµРїСЂРµСЂС‹РІРЅРѕРµ С‡С‚РµРЅРёРµ Р»СЋР±РѕР№ РґР»РёРЅС‹. Р’СЃС‘ РѕС„Р»Р°Р№РЅ.",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "voice",
                     "speech",
                     "tts",
                     "asr",
                     "wake-word",
                     "silero",
                     "gigaam",
                     "offline"
                 ],
    "license":  "MIT",
    "author":  "voice-dialog contributors",
    "type":  "module",
    "engines":  {
                    "dsh":  "\u003e=0.2.2-rc.5"
                },
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "lib/*.js",
                  "locale/*.json",
                  "docs/*.md",
                  "scripts/*.mjs",
                  "scripts/*.ps1",
                  "engine/tts/*.py",
                  "engine/tts/setup.ps1",
                  "cordis.patch.yml",
                  "icon.svg",
                  "README.md",
                  "CHANGELOG.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "doctor":  "node scripts/doctor.mjs",
                    "setup":  "pwsh -NoProfile -File engine/tts/setup.ps1",
                    "package":  "pwsh -NoProfile -File scripts/build-package.ps1"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ]
                           }
            }
}
